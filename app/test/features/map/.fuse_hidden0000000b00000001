import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter/semantics.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:uninav/app/providers.dart';
import 'package:uninav/data/repositories/asset_building_repository.dart';
import 'package:uninav/domain/services/routing/route_prefs.dart';
import 'package:uninav/features/map/presentation/map_screen.dart';
import 'package:uninav/features/navigation/presentation/route_planner_controller.dart';

void main() {
  Widget harness({String? focusRoomId}) {
    final campusJson =
        File('assets/campuses/demo/campus.json').readAsStringSync();
    final bundleJson =
        File('assets/campuses/demo/bundle_main.json').readAsStringSync();
    return ProviderScope(
      overrides: [
        buildingRepositoryProvider.overrideWithValue(
          AssetBuildingRepository(
            loader: (path) async =>
                path.endsWith('campus.json') ? campusJson : bundleJson,
          ),
        ),
      ],
      child: MaterialApp(home: MapScreen(focusRoomId: focusRoomId)),
    );
  }

  /// The dash overlay animates forever, so pumpAndSettle would never settle;
  /// pump fixed frames instead.
  Future<void> settle(WidgetTester tester) async {
    for (var i = 0; i < 4; i++) {
      await tester.pump(const Duration(milliseconds: 50));
    }
  }

  const canvas = ValueKey('map-canvas');

  testWidgets('renders floors and switches between them', (tester) async {
    await tester.pumpWidget(harness());
    await settle(tester);

    expect(find.text('Ground Floor'), findsOneWidget);
    expect(find.text('First Floor'), findsOneWidget);
    expect(find.byKey(canvas), findsOneWidget);

    await tester.tap(find.text('First Floor'));
    await settle(tester);
    expect(find.byKey(canvas), findsOneWidget);
  });

  testWidgets('tapping a room opens its card; tapping corridor closes it',
      (tester) async {
    await tester.pumpWidget(harness());
    await settle(tester);

    // Room 101 label point is (5 m, 5 m) -> (100, 100) px at identity zoom.
    var origin = tester.getTopLeft(find.byKey(canvas));
    await tester.tapAt(origin + const Offset(100, 100));
    await settle(tester);
    expect(find.text('Room 101'), findsOneWidget);
    expect(find.text('Directions'), findsOneWidget);

    // Selecting Room 101 auto-centers the camera on it (docs/15-known-issues
    // .md #7): Room 101's point is now mid-viewport, so re-read the canvas's
    // on-screen origin and tap just *above* the room (empty space, 1 m from
    // the floor's top edge) rather than below it — below is where the
    // now-centered room card overlays the canvas.
    origin = tester.getTopLeft(find.byKey(canvas));
    await tester.tapAt(origin + const Offset(100, 20));
    await settle(tester);
    expect(find.text('Room 101'), findsNothing);
  });

  testWidgets('deep link ?room= selects the room and jumps to its floor',
      (tester) async {
    await tester.pumpWidget(harness(focusRoomId: 'r201'));
    await settle(tester);

    // r201 lives on First Floor: the card shows and the switcher followed.
    expect(find.text('Room 201'), findsOneWidget);
  });

  group('camera auto-centering (docs/15-known-issues.md #7)', () {
    testWidgets('selecting a room centers the camera on it', (tester) async {
      await tester.pumpWidget(harness());
      await settle(tester);

      final origin = tester.getTopLeft(find.byKey(canvas));
      await tester.tapAt(origin + const Offset(100, 100)); // Room 101
      await settle(tester);

      final viewport = tester.getRect(find.byType(InteractiveViewer));
      final roomScreenPoint =
          tester.getTopLeft(find.byKey(canvas)) + const Offset(100, 100);

      expect(roomScreenPoint.dx, closeTo(viewport.center.dx, 1));
      expect(roomScreenPoint.dy, closeTo(viewport.center.dy, 1));
    });

    testWidgets(
        'a route with no room selected centers the camera on the route '
        'start', (tester) async {
      final campusJson =
          File('assets/campuses/demo/campus.json').readAsStringSync();
      final bundleJson =
          File('assets/campuses/demo/bundle_main.json').readAsStringSync();
      final container = ProviderContainer(
        overrides: [
          buildingRepositoryProvider.overrideWithValue(
            AssetBuildingRepository(
              loader: (path) async =>
                  path.endsWith('campus.json') ? campusJson : bundleJson,
            ),
          ),
        ],
      );
      addTearDown(container.dispose);

      await tester.pumpWidget(
        UncontrolledProviderScope(
          container: container,
          child: const MaterialApp(home: MapScreen()),
        ),
      );
      await settle(tester);

      // Room 102's node -> (15 m, 5 m) -> (300, 100) px; distinct from Room
      // 101 so this can't pass by coincidence.
      await container.read(plannerControllerProvider.notifier).plan(
            fromNodeId: 'n_r102',
            toNodeId: 'n_r103',
            prefs: RoutePrefs.fastest,
          );
      await settle(tester);

      final viewport = tester.getRect(find.byType(InteractiveViewer));
      final routeStartScreenPoint =
          tester.getTopLeft(find.byKey(canvas)) + const Offset(300, 100);

      expect(routeStartScreenPoint.dx, closeTo(viewport.center.dx, 1));
      expect(routeStartScreenPoint.dy, closeTo(viewport.center.dy, 1));
    });
  });

  group('room semantics (docs/15-known-issues.md #4)', () {
    testWidgets('every room on the floor is a reachable semantics node',
        (tester) async {
      final handle = tester.ensureSemantics();

      await tester.pumpWidget(harness());
      await settle(tester);

      final traversal = tester.semantics.simulatedAccessibilityTraversal();
      expect(
        traversal,
        containsAllInOrder(<Matcher>[
          isSemantics(
            label: 'Room 101, classroom',
            isButton: true,
            hasTapAction: true,
          ),
          isSemantics(
            label: 'Room 102, classroom',
            isButton: true,
            hasTapAction: true,
          ),
          isSemantics(
            label: 'Physics Lab, lab',
            isButton: true,
            hasTapAction: true,
          ),
        ]),
      );

      handle.dispose();
    });

    testWidgets('selecting a room via tap marks its semantics node selected',
        (tester) async {
      final handle = tester.ensureSemantics();

      await tester.pumpWidget(harness());
      await settle(tester);

      final origin = tester.getTopLeft(find.byKey(canvas));
      await tester.tapAt(origin + const Offset(100, 100)); // Room 101
      await settle(tester);

      expect(
        tester.semantics.simulatedAccessibilityTraversal(),
        contains(
          isSemantics(
            label: 'Room 101, classroom',
            isButton: true,
            isSelected: true,
            hasTapAction: true,
          ),
        ),
      );

      handle.dispose();
    });

    testWidgets(
        'activating a room through its semantics action selects it, '
        'same as a sighted tap', (tester) async {
      final handle = tester.ensureSemantics();

      await tester.pumpWidget(harness());
      await settle(tester);

      final node = tester.semantics
          .simulatedAccessibilityTraversal()
          .firstWhere((n) => n.label.startsWith('Room 101,'));
      node.owner!.performAction(node.id, SemanticsAction.tap);
      await settle(tester);

      expect(find.text('Room 101'), findsOneWidget);
      expect(find.text('Directions'), findsOneWidget);

      handle.dispose();
    });
  });
}
