import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:go_router/go_router.dart';
import 'package:uninav/app/providers.dart';
import 'package:uninav/data/repositories/asset_building_repository.dart';
import 'package:uninav/features/search/presentation/search_screen.dart';

void main() {
  Widget harness() {
    final campusJson =
        File('assets/campuses/demo/campus.json').readAsStringSync();
    final bundleJson =
        File('assets/campuses/demo/bundle_main.json').readAsStringSync();
    final router = GoRouter(
      initialLocation: '/search',
      routes: [
        GoRoute(
          path: '/search',
          builder: (context, state) => const SearchScreen(),
        ),
        // Stubs: the test asserts navigation targets, not those screens.
        GoRoute(
          path: '/map',
          builder: (context, state) =>
              Text('map-stub:${state.uri.queryParameters['room']}'),
        ),
        GoRoute(
          path: '/plan',
          builder: (context, state) =>
              Text('plan-stub:${state.uri.queryParameters['dest']}'),
        ),
        GoRoute(path: '/', builder: (context, state) => const Text('home')),
      ],
    );
    return ProviderScope(
      overrides: [
        buildingRepositoryProvider.overrideWithValue(
          AssetBuildingRepository(
            loader: (path) async =>
                path.endsWith('campus.json') ? campusJson : bundleJson,
          ),
        ),
      ],
      child: MaterialApp.router(routerConfig: router),
    );
  }

  Future<void> typeAndSettle(WidgetTester tester, String text) async {
    await tester.enterText(find.byType(TextField), text);
    await tester.pump(const Duration(milliseconds: 300)); // past debounce
    await tester.pump();
  }

  testWidgets('typing finds rooms, including typos', (tester) async {
    await tester.pumpWidget(harness());
    await tester.pump(); // resolve bundle/index futures

    await typeAndSettle(tester, 'physics');
    expect(find.text('Physics Lab'), findsOneWidget);

    await typeAndSettle(tester, 'physcis'); // transposition typo
    expect(find.text('Physics Lab'), findsOneWidget);

    await typeAndSettle(tester, 'zzqx');
    expect(find.textContaining('Nothing found'), findsOneWidget);
  });

  testWidgets('tapping a result opens the map focused on it, and records '
      'a recent', (tester) async {
    await tester.pumpWidget(harness());
    await tester.pump();

    await typeAndSettle(tester, '101');
    await tester.tap(find.text('Room 101'));
    await tester.pumpAndSettle();
    expect(find.text('map-stub:r101'), findsOneWidget);

    // Back to search: the pick shows under Recent on the empty query.
    final ctx = tester.element(find.text('map-stub:r101'));
    GoRouter.of(ctx).pop();
    await tester.pumpAndSettle();
    await typeAndSettle(tester, '');
    expect(find.text('Recent'), findsOneWidget);
    expect(find.text('Room 101'), findsOneWidget);
  });

  testWidgets('directions button goes to the planner with dest set',
      (tester) async {
    await tester.pumpWidget(harness());
    await tester.pump();

    await typeAndSettle(tester, 'dean');
    await tester.tap(find.byTooltip('Directions'));
    await tester.pumpAndSettle();
    expect(find.text('plan-stub:r202'), findsOneWidget);
  });
}
